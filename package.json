{
	"name": "devboard",
	"private": true,
	"workspaces": [
		"apps/web"
	],
	"scripts": {
		"dev": "npm run dev -w apps/web",
		"build": "npm run build -w apps/web",
		"format": "prettier --write \"apps/web/**/*.{ts,tsx,mjs,css,json}\"",
		"format:check": "prettier --check \"apps/web/**/*.{ts,tsx,mjs,css,json}\"",
		"lint": "npm run lint -w apps/web",
		"test": "npm run test -w apps/web",
		"typecheck": "npm run typecheck -w apps/web"
	}
}
